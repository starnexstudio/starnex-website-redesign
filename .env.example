# The site needs no secrets. This is the only setting, and it is read by _build/publish.mjs.
# Set STARNEX_ENV=preview on a preview host only: it marks every page noindex.
# Leave it unset on production.
STARNEX_ENV=
# Preview only: the path the preview is served under, for example /starnex-website-redesign.
STARNEX_BASE=
